# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.insidephilippines.com   # PLACEHOLDER domain (defaults to the Vercel URL)
NEXT_PUBLIC_ALLOW_INDEXING=false                          # set to true at launch, once placeholders are replaced
NEXT_PUBLIC_WHATSAPP_NUMBER=                              # e.g. 639171234567 (digits only, with country code)
NEXT_PUBLIC_CONTACT_EMAIL=                                # e.g. hello@insidephilippines.com

# ---- Analytics (scripts load only when set AND the visitor consents) ----
NEXT_PUBLIC_GA4_ID=            # G-XXXXXXX
NEXT_PUBLIC_GTM_ID=            # optional, GTM-XXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=     # AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=   # conversion label for "lead"
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=      # Search Console HTML-tag token

# ---- CRM / leads ----
HUBSPOT_PRIVATE_APP_TOKEN=     # HubSpot private app with crm.objects.contacts.write + deals.write
HUBSPOT_PIPELINE_ID=           # "Travel journeys" pipeline id
HUBSPOT_STAGE_NEW_LEAD=        # stage id for NEW LEAD
LEAD_WEBHOOK_URL=              # optional: Zapier/Make/Slack webhook that also receives every lead
NEWSLETTER_WEBHOOK_URL=        # optional: Brevo/Mailchimp/Klaviyo signup endpoint

# ---- CMS (Sanity) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
